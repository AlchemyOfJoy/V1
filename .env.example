# Copy this file to .env and fill in the values.

# --- Database (required) ---
# PostgreSQL connection string. On Vercel, the Neon/Postgres integration
# sets this automatically. For local dev, point it at any Postgres database.
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# --- Public URL (recommended in production) ---
# The deployed URL of the app — used for Google OAuth redirects.
# On Vercel this can be left blank; it is auto-detected per request.
NEXT_PUBLIC_APP_URL=""

# --- Google sign-in (optional) ---
# Leave blank to disable the "Continue with Google" button.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your-app-url>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
