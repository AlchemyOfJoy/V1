# Copy this file to .env and fill in the values you need.

# --- Database (optional) ---
# Where the SQLite database file lives. Defaults to ./data/jq.db
# DATABASE_PATH="./data/jq.db"

# --- Google sign-in (optional) ---
# Leave blank to disable the "Continue with Google" button.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: <your-app-url>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public URL of the app. Needed for Google OAuth redirects in production.
# In local dev this is auto-detected; set it when deploying.
# NEXT_PUBLIC_APP_URL="https://your-app.example.com"
